<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080d16">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<style><%- include("../index.css") %></style>
<style>
    :root {
        color-scheme: dark;
        --ink: #080d16;
        --glass: rgba(19, 31, 49, .62);
        --glass-strong: rgba(20, 34, 54, .82);
        --line: rgba(190, 216, 255, .14);
        --white: #f3f7ff;
        --muted: #a2b0c4;
        --blue: #79b7ff;
        --blue-bright: #a4d1ff;
        --brown: #c18a68;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { min-width: 320px; background: var(--ink); }
    body {
        min-height: 100vh;
        margin: 0;
        overflow-x: hidden;
        color: var(--white);
        background:
            radial-gradient(ellipse at 12% 7%, rgba(32, 93, 158, .28), transparent 35rem),
            radial-gradient(ellipse at 88% 34%, rgba(117, 75, 54, .16), transparent 33rem),
            linear-gradient(145deg, #080d16 0%, #0a1321 48%, #0b1018 100%);
        background-attachment: fixed;
        font-family: "DM Sans", sans-serif;
        line-height: 1.65;
    }
    h1, h2, h3, h4 { font-family: Georgia, "Times New Roman", serif; font-weight: 500; }
    a { color: var(--blue-bright); }
    a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
        outline: 2px solid var(--blue-bright);
        outline-offset: 3px;
    }
    .navbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        padding: 10px max(20px, calc((100vw - 1240px) / 2));
        border-bottom: 1px solid var(--line);
        background: rgba(8, 13, 22, .74) !important;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }
    .navbar .container-fluid { padding: 0; }
    .navbar-brand { color: var(--white) !important; font-weight: 800; letter-spacing: 0; }
    .navbar-brand { font-size: 1.12rem; }
    .navbar-brand::before { content: "B/"; margin-right: 8px; color: var(--blue); font-family: "DM Sans", sans-serif; font-size: .92rem; font-weight: 700; }
    .navbar-nav { align-items: center; gap: 8px; }
    .nav-link { padding: 9px 14px !important; color: #c0cada !important; font-weight: 600; transition: color .2s ease, background .2s ease; }
    .nav-link:hover, .nav-link.active { color: var(--white) !important; }
    .nav-link:hover { border-radius: 999px; background: rgba(255,255,255,.07); }
    .navbar-toggler { border-color: var(--line); }
    .navbar-toggler:focus { box-shadow: 0 0 0 .2rem rgba(121,183,255,.2); }
    .glass-panel, .blog-card, .auth-panel, .editor-panel, .comment-card {
        border: 1px solid var(--line);
        background: var(--glass);
        box-shadow: 0 20px 60px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.06);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }
    .home-container, .blog-container, .form-page { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
    .home-container { padding: clamp(36px, 6vw, 72px) 0 80px; }
    .home-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; max-width: none; margin: 0 0 34px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
    .eyebrow { color: var(--blue-bright); font-size: .72rem; font-weight: 700; text-transform: uppercase; }
    .home-heading .eyebrow { letter-spacing: .12em; }
    .home-heading h1 { max-width: 680px; margin: 10px 0 8px; font-size: clamp(2.3rem, 5vw, 4rem); line-height: 1.07; font-weight: 500; }
    .home-heading p { max-width: 590px; margin: 0; color: var(--muted); font-size: 1rem; }
    .edition-note { flex: 0 0 auto; padding-bottom: 5px; color: var(--muted); font-size: .75rem; letter-spacing: .08em; text-align: right; text-transform: uppercase; }
    .featured-story { display: grid; grid-template-columns: 1.05fr .95fr; min-height: 360px; overflow: hidden; border: 1px solid var(--line); border-radius: 10px; background: linear-gradient(120deg, rgba(22,38,59,.78), rgba(15,25,39,.55)); box-shadow: 0 20px 55px rgba(0,0,0,.18); }
    .featured-copy { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(26px, 5vw, 58px); }
    .story-index { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; color: var(--blue-bright); font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .story-index::before { width: 26px; height: 1px; background: var(--brown); content: ""; }
    .featured-copy h2 { max-width: 560px; margin: 0 0 16px; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.08; overflow-wrap: anywhere; }
    .featured-excerpt { display: -webkit-box; max-width: 560px; overflow: hidden; margin: 0; color: #b6c3d4; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
    .featured-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 30px; }
    .story-date { color: var(--muted); font-size: .8rem; }
    .featured-link { display: inline-flex; align-items: center; gap: 10px; color: var(--white); font-size: .9rem; font-weight: 700; text-decoration: none; }
    .featured-link span { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--blue-bright); transition: transform .2s ease, background .2s ease; }
    .featured-link:hover { color: white; }
    .featured-link:hover span { transform: translateX(3px); background: rgba(121,183,255,.13); }
    .featured-image-wrap { position: relative; min-height: 280px; overflow: hidden; background: rgba(255,255,255,.035); }
    .featured-image-wrap::after { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,25,39,.28), transparent 38%), linear-gradient(0deg, rgba(8,13,22,.15), transparent 45%); content: ""; pointer-events: none; }
    .featured-image { display: block; width: 100%; height: 100%; min-height: inherit; object-fit: cover; }
    .archive-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin: 54px 0 20px; }
    .archive-heading h2 { margin: 0; font-size: 1.55rem; }
    .archive-heading span { color: var(--muted); font-size: .8rem; }
    .blog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
    .blog-card { min-width: 0; overflow: hidden; border-radius: 8px; transition: transform .25s ease, border-color .25s ease, background .25s ease; }
    .blog-card:hover { transform: translateY(-3px); border-color: rgba(164,209,255,.38); background: rgba(25,42,65,.76); }
    .blog-card-image-wrapper { overflow: hidden; aspect-ratio: 16 / 10; background: rgba(255,255,255,.04); }
    .blog-card-image { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
    .blog-card:hover .blog-card-image { transform: scale(1.035); }
    .blog-card-body { display: flex; min-height: 190px; flex-direction: column; padding: 20px; }
    .blog-card-title { margin: 0 0 10px; color: var(--white); font-family: Georgia, "Times New Roman", serif; font-size: 1.25rem; line-height: 1.3; font-weight: 500; }
    .blog-card-text { display: -webkit-box; overflow: hidden; margin: 0; color: var(--muted); -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
    .blog-card-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; padding-top: 20px; }
    .read-more { color: var(--blue-bright); font-size: .9rem; font-weight: 700; text-decoration: none; }
    .read-more:hover { color: white; }
    .empty-state { padding: 34px; border-radius: 12px; color: var(--muted); }
    .blog-container { max-width: 850px; padding: 62px 0 88px; }
    .article-panel { padding: clamp(22px, 5vw, 54px); border-radius: 14px; }
    .blog-header { margin-bottom: 28px; }
    .blog-header h1 { margin: 0 0 18px; font-size: clamp(2.2rem, 6vw, 4.3rem); line-height: 1.08; font-weight: 800; overflow-wrap: anywhere; }
    .blog-meta { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: .92rem; }
    .author-avatar { width: 42px; height: 42px; flex: 0 0 auto; border: 1px solid var(--line); border-radius: 50%; object-fit: cover; }
    .blog-cover { display: block; width: 100%; max-height: 540px; margin: 0 0 30px; border: 1px solid var(--line); border-radius: 10px; object-fit: cover; }
    .blog-content { margin: 0; color: #d8e1ef; font-size: 1.05rem; line-height: 1.9; overflow-wrap: anywhere; }
    .blog-content pre, .comment-content { margin: 0; color: inherit; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
    .comments-section { margin-top: 34px; }
    .comments-section h2 { margin-bottom: 20px; font-size: 1.35rem; }
    .comment-form { display: flex; gap: 10px; margin-bottom: 22px; }
    .comment-list { display: grid; gap: 12px; }
    .comment-card { display: flex; align-items: flex-start; gap: 13px; padding: 16px; border-radius: 10px; }
    .comment-author { margin-bottom: 4px; color: var(--blue-bright); font-size: .9rem; font-weight: 700; }
    .form-page { max-width: 620px; padding: clamp(40px, 8vw, 82px) 0; }
    .form-heading { margin: 0 0 24px; }
    .form-heading h1 { margin: 8px 0; font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; }
    .form-heading p { margin: 0; color: var(--muted); }
    .auth-panel, .editor-panel { padding: clamp(22px, 5vw, 38px); border-radius: 12px; }
    .form-label { color: #dce7f6; font-size: .92rem; font-weight: 600; }
    .form-control { min-height: 46px; border: 1px solid rgba(190,216,255,.17); border-radius: 8px; color: var(--white); background: rgba(5,11,20,.48); }
    .form-control:focus { border-color: rgba(121,183,255,.65); color: white; background: rgba(5,11,20,.68); box-shadow: 0 0 0 .2rem rgba(121,183,255,.13); }
    .form-control::placeholder, .form-text { color: #91a0b6; }
    input[type="file"].form-control { padding: 8px; }
    input[type="file"]::file-selector-button { margin: -2px 10px -2px -2px; padding: 7px 12px; border: 0; border-radius: 5px; color: var(--white); background: rgba(121,183,255,.18); }
    textarea.form-control { min-height: 230px; resize: vertical; }
    .btn-primary { border: 1px solid rgba(164,209,255,.45) !important; border-radius: 8px; padding: 10px 18px; color: #07111f !important; background: linear-gradient(135deg, #b0d8ff, #72b5fa) !important; font-weight: 700; transition: filter .2s ease, transform .2s ease; }
    .btn-primary:hover { transform: translateY(-1px); filter: brightness(1.07); }
    .btn-sm { padding: 8px 14px; }
    .form-switch-link { margin: 20px 0 0; color: var(--muted); text-align: center; }
    .form-switch-link a { font-weight: 700; text-decoration: none; }
    .alert { max-width: 1120px; margin: 16px auto; border-color: rgba(255,150,150,.25); color: #ffd8d8; background: rgba(100,30,38,.55); }
    .dropdown-menu { border: 1px solid var(--line); border-radius: 9px; background: var(--glass-strong); backdrop-filter: blur(16px); }
    .dropdown-item { color: #dce7f6; }
    .dropdown-item:hover { color: white; background: rgba(255,255,255,.08); }
    ::selection { color: white; background: #28659b; }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .glass-panel, .blog-card, .auth-panel, .editor-panel, .comment-card, .dropdown-menu { background: #142033; }
    }
    @media (max-width: 900px) {
        .blog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .featured-story { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 767px) {
        .navbar { padding: 8px 16px; }
        .navbar-nav { align-items: stretch; gap: 2px; padding: 8px 0; }
        .home-container, .blog-container, .form-page { width: min(100% - 32px, 620px); }
        .home-container { padding-top: 38px; }
        .home-heading { align-items: flex-start; flex-direction: column; gap: 12px; }
        .edition-note { text-align: left; }
        .featured-story { grid-template-columns: 1fr; }
        .featured-copy { order: 1; }
        .featured-image-wrap { order: 0; min-height: 0; aspect-ratio: 16 / 10; }
        .featured-image { min-height: 0; }
        .archive-heading { margin-top: 40px; }
        .blog-grid { grid-template-columns: 1fr; gap: 16px; }
        .blog-card-body { min-height: 0; }
        .blog-container { padding-top: 34px; }
        .comment-form { align-items: stretch; flex-direction: column; }
        .comment-form .btn { align-self: flex-end; }
        .alert { width: calc(100% - 32px); }
    }
    @media (max-width: 420px) {
        .featured-footer { align-items: flex-start; flex-direction: column; gap: 14px; }
        .article-panel { padding: 20px 16px; }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }
</style>