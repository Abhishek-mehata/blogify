<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("./partials/head") %>
        <title>Blog Page</title>
</head>

<body style="background-color: black; color: white;">
    <%- include("./partials/nav") %>


        <div class="container">
            <h1>
                <%= blog.title %>
            </h1>
            <img src="<%= blog.coverImageUrl %>" width="700px" alt="<%= blog.coverImageUrl %>">
            <pre>
                <%= blog.body %>
            </pre>
        </div>

        <div class="container mt-3">
            <img src="<%= blog.createdBy.profileImageURL %>" width="50" height="50" alt="">
            <%= blog.createdBy.fullName %>
        </div>


        <div class="container mt-3">
            <h1>Comments (<%= comments.length %>)</h1>
            <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="post">

                    <div class="mb-3">
                        <input type="text" class="form-control" id="content" aria-describedby="email" name="content"
                            placeholder="Enter your Comment">
                        <button type="submit" class="btn btn-sm btn-primary">Add</button>
                    </div>
                </form>
                <% } %>
        </div>


        <div class="mt-3">
            <% locals.comments.forEach(comment=> { %>
                <div>
                    <img src="<%= comment.createdBy.profileImageURL %>" width="50" height="50" alt="">
                    <%= comment.createdBy.fullName %>:
                        <pre><%= comment.content %></pre>

                </div>
                <% }) %>
        </div>
        <%- include("./partials/scripts") %>
</body>

</html>