<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("./partials/head") %>
        <title><%= blog.title %> | Blogify</title>
</head>

<body>
    <%- include("./partials/nav") %>

    <main class="blog-container">
        <article class="glass-panel article-panel">
            <header class="blog-header">
                <h1><%= blog.title %></h1>
                <div class="blog-meta">
                    <img src="<%= blog.createdBy.profileImageURL %>" class="author-avatar" alt="">
                    <span>Written by <strong><%= blog.createdBy.fullName %></strong></span>
                    <% if (blog.createdAt) { %>
                        <span aria-hidden="true">/</span>
                        <time datetime="<%= new Date(blog.createdAt).toISOString() %>"><%= new Date(blog.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
                    <% } %>
                </div>
            </header>
            <% if (blog.coverImageUrl) { %>
                <img src="<%= blog.coverImageUrl %>" class="blog-cover" alt="Cover for <%= blog.title %>">
            <% } %>
            <pre class="blog-content"><%= blog.body %></pre>
        </article>

        <section class="comments-section" aria-labelledby="comments-heading">
            <h2 id="comments-heading">Conversation (<%= comments.length %>)</h2>
            <% if (locals.user) { %>
                <form class="comment-form" action="/blog/comment/<%= blog._id %>" method="post">
                    <input type="text" class="form-control" id="content" name="content" placeholder="Add to the conversation" aria-label="Your comment" required>
                    <button type="submit" class="btn btn-primary btn-sm">Post comment</button>
                </form>
            <% } else { %>
                <p class="comment-empty">Sign in to join the conversation. <a href="/user/signin">Sign in</a></p>
            <% } %>
            <% if (comments.length) { %>
                <div class="comment-list">
                    <% locals.comments.forEach(comment=> { %>
                        <article class="comment-card">
                            <img src="<%= comment.createdBy.profileImageURL %>" class="author-avatar" alt="">
                            <div>
                                <div class="comment-author"><%= comment.createdBy.fullName %></div>
                                <pre class="comment-content"><%= comment.content %></pre>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="comment-empty">No comments yet. Be the first to share a thought.</p>
            <% } %>
        </section>
    </main>
        <%- include("./partials/scripts") %>
</body>

</html>